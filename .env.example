# Gita Guide API — safe local-development defaults
# Copy to `.env`, then provide the two required provider keys.

# Local runtime and private frontend-to-backend credential
APP_ENVIRONMENT=development
APP_API_KEY=local-dev-change-me
GUIDANCE_API_ENABLED=true
GUIDANCE_RELEASE_APPROVED=false
GUIDANCE_PRIVATE_BETA_ENABLED=true

# Required: OpenRouter provides JEV decisions and DeepSeek generation
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.13
OPENROUTER_GENERATION_MODEL=deepseek/deepseek-v4.1-flash

# Required for retrieval embeddings; the hosted safety rail is optional locally
NVIDIA_API_KEY=
NVIDIA_GUARDRAIL_REQUIRED=false

# A single local process does not need shared Redis
CACHE_BACKEND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_HMAC_SECRET=

# Local audit and privacy-preserving prompt fingerprints
AUDIT_LOG_PATH=var/audit/phase1.jsonl
PROMPT_FINGERPRINT_SECRET=

# Optional locally. Enable only with a valid LangSmith key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gita-guide-local

# Vercel production overrides:
# APP_ENVIRONMENT=production
# NVIDIA_GUARDRAIL_REQUIRED=true
# CACHE_BACKEND=upstash
# AUDIT_LOG_PATH=/tmp/gita-guide/phase1.jsonl
# LANGSMITH_TRACING=true
