OPENROUTER_API_KEY=replace_with_your_openrouter_key
APP_ENVIRONMENT=development
OPENROUTER_MODEL=typesafe/jev-1.13
OPENROUTER_TIMEOUT_SECONDS=30
PROVIDER_MAX_ATTEMPTS=2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
CLASSIFICATION_SCOPE_THRESHOLD=0.5
CLASSIFICATION_MIN_CONFIDENCE=0.6

# NVIDIA's hosted development endpoint. NVIDIA_API_KEY is never logged.
NVIDIA_API_KEY=replace_with_your_nvidia_key
NVIDIA_GUARDRAIL_URL=https://integrate.api.nvidia.com/v1
NVIDIA_GUARDRAIL_MODEL=nvidia/nemotron-3.5-content-safety

# Reuses NVIDIA_API_KEY. The hosted embedding endpoint is suitable for
# development; production should use an approved hosted or self-hosted NIM.
NVIDIA_EMBEDDING_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_BATCH_SIZE=32
NVIDIA_EMBEDDING_TIMEOUT_SECONDS=60

# Set true in production to fail closed when the NVIDIA rail is unavailable.
NVIDIA_GUARDRAIL_REQUIRED=false

# Local development uses an in-process cache. Set CACHE_BACKEND=upstash in a
# multi-instance deployment. Keep the HMAC secret stable and at least 32 bytes.
# The original message is never a Redis key or value identifier.
CACHE_BACKEND=memory
# Upstash REST credentials (used only when CACHE_BACKEND=upstash).
UPSTASH_REDIS_REST_URL=https://replace-with-your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_your_upstash_rest_token
# Optional traditional Redis alternative (used only when CACHE_BACKEND=redis).
REDIS_URL=redis://localhost:6379/0
CACHE_HMAC_SECRET=replace_with_at_least_32_random_characters
CLASSIFICATION_CACHE_TTL_SECONDS=3600
IDEMPOTENCY_TTL_SECONDS=86400
CACHE_TENANT_ID=default

# Append-only decision audit. Set blank only when another AuditSink is configured.
AUDIT_LOG_PATH=var/audit/phase1.jsonl

# HTTP boundary. Leave APP_API_KEY blank only for local development.
APP_API_KEY=
API_MAX_REQUEST_BODY_BYTES=16384

# JSON application logs. Prompt events are always logged; raw prompt text is
# disabled by default because messages can contain sensitive personal details.
LOG_LEVEL=INFO
LOG_PROMPT_CONTENT=false
PROMPT_FINGERPRINT_SECRET=replace_with_at_least_32_random_characters
PROMPT_FINGERPRINT_KEY_ID=production-v1

# Optional LangSmith traces for the complete LangChain Phase 1 pipeline.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace_with_your_langsmith_key
LANGSMITH_PROJECT=gita-guide-phase-1
