# Vercel BACKEND project configuration (repository root).
# Add these in Project Settings; never commit real values. Do not add provider,
# Upstash, LangSmith, or APP_API_KEY secrets to NEXT_PUBLIC_* variables.

# Application mode and server-only API boundary
APP_ENVIRONMENT=production
APP_API_KEY=replace_with_a_long_random_server_only_value
API_MAX_REQUEST_BODY_BYTES=32768

# OpenRouter: JEV classification/evaluation and Gemma response generation
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_MODEL=typesafe/jev-1.13
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_GENERATION_URL=https://openrouter.ai/api/v1
# Reliability-oriented standard route; do not add :free for the private beta.
OPENROUTER_GENERATION_MODEL=google/gemma-4-31b-it
OPENROUTER_GENERATION_TEMPERATURE=0.2
OPENROUTER_GENERATION_MAX_TOKENS=320
OPENROUTER_GENERATION_TIMEOUT_SECONDS=45

# Provider resilience. Transport retries do not consume answer-revision attempts.
PROVIDER_MAX_ATTEMPTS=2
GENERATION_MAX_ATTEMPTS=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# NVIDIA: mandatory production safety rails and query embeddings only
NVIDIA_API_KEY=replace_with_your_nvidia_key
NVIDIA_GUARDRAIL_URL=https://integrate.api.nvidia.com/v1
NVIDIA_GUARDRAIL_MODEL=nvidia/nemotron-3.5-content-safety
NVIDIA_GUARDRAIL_REQUIRED=true
NVIDIA_EMBEDDING_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_BATCH_SIZE=32
NVIDIA_EMBEDDING_TIMEOUT_SECONDS=60

# Classification, retrieval and grounded-answer thresholds
CLASSIFICATION_SCOPE_THRESHOLD=0.5
CLASSIFICATION_MIN_CONFIDENCE=0.6
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_VALIDATION_K=5
RETRIEVAL_TOP_K=3
RETRIEVAL_MINIMUM_SCORE=0.0
RETRIEVAL_MMR_LAMBDA=0.8
RETRIEVAL_MAX_PER_CHAPTER=2
RETRIEVAL_VALIDATION_THRESHOLD=0.65
ANSWER_VALIDATION_THRESHOLD=0.75
ANSWER_FAITHFULNESS_THRESHOLD=0.80
ANSWER_CITATION_COVERAGE_THRESHOLD=0.80
ANSWER_HELPFULNESS_THRESHOLD=0.75
ANSWER_AGENCY_THRESHOLD=0.80

# Shared cache and idempotency for serverless instances
CACHE_BACKEND=upstash
UPSTASH_REDIS_REST_URL=https://replace-with-your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_your_upstash_rest_token
CACHE_HMAC_SECRET=replace_with_an_independent_32_byte_secret
CLASSIFICATION_CACHE_TTL_SECONDS=3600
IDEMPOTENCY_TTL_SECONDS=86400
RETRIEVAL_CACHE_TTL_SECONDS=21600
CACHE_TENANT_ID=private-beta

# Rolling conversation memory
CONVERSATION_SUMMARY_TRIGGER_TURNS=6
CONVERSATION_SUMMARY_RETAIN_RECENT_TURNS=2
CONVERSATION_SUMMARY_MAX_TOKENS=300

# Vercel's filesystem is ephemeral. This is startup-compatible, not a durable
# enterprise audit sink; replace it with centralized append-only storage later.
AUDIT_LOG_PATH=/tmp/gita-guide/phase1.jsonl

# Structured logs and LangSmith traces
LOG_LEVEL=INFO
LOG_PROMPT_CONTENT=false
PROMPT_FINGERPRINT_SECRET=replace_with_an_independent_32_byte_secret
PROMPT_FINGERPRINT_KEY_ID=production-v1
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace_with_your_langsmith_key
LANGSMITH_PROJECT=gita-guide-private-beta

# Current 5-10 user private-beta posture. This does not claim general release.
GUIDANCE_API_ENABLED=true
GUIDANCE_RELEASE_APPROVED=false
GUIDANCE_PRIVATE_BETA_ENABLED=true
