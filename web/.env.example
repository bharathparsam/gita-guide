# Safe to expose in the browser. Find these in Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key used by authenticated route handlers to persist assistant
# messages and rolling summaries. Never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Never prefix these with NEXT_PUBLIC_.
BACKEND_API_URL=http://127.0.0.1:8000
APP_API_KEY=replace-with-the-same-key-used-by-the-python-api

# Server-only guest abuse protection. The Redis values may point to the same
# Upstash database as the backend cache. Generate a separate HMAC secret with:
# openssl rand -hex 32
UPSTASH_REDIS_REST_URL=https://replace-with-your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
GUEST_RATE_LIMIT_SECRET=replace-with-an-independent-random-secret
