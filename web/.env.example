# Gita Guide Web — safe local-development defaults
# Copy to `.env.local` (or `.env`) before running `npm run dev`.

# APP_API_KEY must exactly match the backend `.env` value.
BACKEND_API_URL=http://127.0.0.1:8000
APP_API_KEY=local-dev-change-me

# Optional locally; required for production guest abuse protection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GUEST_RATE_LIMIT_SECRET=
